# Settings that every tape loads with `Source demos/style.tape`.
Set Shell "zsh"
Set FontFamily "JetBrainsMono Nerd Font"
Set FontSize 18
Set LineHeight 1.25
Set Width 1400
Set Height 940
Set Padding 28
Set Theme "Catppuccin Mocha"
Set WindowBar Colorful
Set BorderRadius 10
Set Margin 24
Set MarginFill "#11111b"
Set TypingSpeed 45ms
Set Framerate 20
Set WaitTimeout 240s
Set WaitPattern /❯\s*$/
